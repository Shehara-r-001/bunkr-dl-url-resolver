{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "entrypoints/**/*",
    "src/**/*",
    "tests/**/*",
    ".wxt/wxt.d.ts"
  ]
}
