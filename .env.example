# Bunkr -> FDM Resolver Environment Variables (Optional / Development)
# All runtime resolving is client-side; no API keys or private credentials are required.

# Enable verbose diagnostic logging in development (true / false)
WXT_DEBUG=false

# Override signing and fallback API endpoints if domain changes occur
WXT_BUNKR_SIGN_API=https://glb-apisign.cdn.cr/sign
WXT_BUNKR_DOWNLOAD_API=https://dl.bunkr.cr/api/_001_v2

# Default request timeout in milliseconds
WXT_REQUEST_TIMEOUT_MS=15000
